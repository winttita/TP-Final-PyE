# ============================================================
# TP ESTADÍSTICA TUIA 2026
# Marco metodológico: ciclo PPDAC
# (Problema - Plan - Datos - Análisis - Conclusión)
# ============================================================
library(tidyverse)
# --- [P] PROBLEMA ---
# Esta etapa se documenta en el informe PDF, no en el código.
# Incluye: introducción, unidad de análisis, población objetivo,
# definición de las 4 variables de interés y parámetros asociados.
# --- [PL] PLAN: Diseño muestral ---
# Se fija la semilla para garantizar reproducibilidad del muestreo
set.seed(2026)
# Lectura de la población (N) asumiendo que el archivo está en el directorio de trabajo
datos_poblacion <- read_tsv("title.basics.tsv", na = "\\N")
# Extracción de la muestra aleatoria simple (n = 500)
# Se filtran previamente registros incompletos para asegurar calidad de los datos
muestra_cruda <- datos_poblacion %>%
filter(startYear == 2023) %>%        # Garantiza análisis transversal
filter(!is.na(runtimeMinutes)) %>%   # Elimina registros sin duración
filter(!is.na(genres)) %>%           # Elimina registros sin género
slice_sample(n = 500)
# --- [D] DATOS: Construcción de variables ---
# Se generan las 4 variables de interés a partir de la muestra
datos_tp <- muestra_cruda %>%
mutate(
# Variable Cualitativa Nominal: primer género listado
genero_principal = str_extract(genres, "[^,]+"),
# Variable Cuantitativa Discreta: cantidad de géneros por título
cant_generos = str_count(genres, ",") + 1,
# Variable Cualitativa Ordinal: categoría según duración
categoria_duracion = factor(
case_when(
runtimeMinutes <= 30                        ~ "Cortometraje",
runtimeMinutes > 30 & runtimeMinutes <= 60  ~ "Mediometraje",
runtimeMinutes > 60                         ~ "Largometraje"
),
levels = c("Cortometraje", "Mediometraje", "Largometraje"),
ordered = TRUE
)
)
# --- [A] ANÁLISIS: Descriptivo ---
# A. Variable Cuantitativa Continua: Duración (runtimeMinutes)
resumen_duracion <- datos_tp %>%
summarise(
tamano_muestra = n(),
media_x        = mean(runtimeMinutes, na.rm = TRUE),
mediana        = median(runtimeMinutes, na.rm = TRUE),
varianza_s2    = var(runtimeMinutes, na.rm = TRUE),
desvio_s       = sd(runtimeMinutes, na.rm = TRUE),
cv_porcentaje  = desvio_s / media_x * 100
)
print(resumen_duracion)
# B. Variable Cualitativa Nominal: Género Principal
tabla_generos <- datos_tp %>%
count(genero_principal, name = "frecuencia_absoluta") %>%
mutate(
frecuencia_relativa = frecuencia_absoluta / sum(frecuencia_absoluta),
porcentaje          = frecuencia_relativa * 100
) %>%
arrange(desc(frecuencia_absoluta))
print(tabla_generos)
# C. Variable Cualitativa Ordinal: Categoría de Duración
tabla_categorias <- datos_tp %>%
count(categoria_duracion, name = "frecuencia_absoluta") %>%
mutate(porcentaje = frecuencia_absoluta / sum(frecuencia_absoluta) * 100)
print(tabla_categorias)
# D. Variable Cuantitativa Discreta: Cantidad de Géneros
tabla_cant_generos <- datos_tp %>%
count(cant_generos, name = "frecuencia_absoluta") %>%
mutate(porcentaje = frecuencia_absoluta / sum(frecuencia_absoluta) * 100)
print(tabla_cant_generos)
# Visualización del análisis descriptivo
# 1. Gráfico de barras: Género Principal (Cualitativa Nominal)
grafico_generos <- ggplot(tabla_generos, aes(x = reorder(genero_principal, frecuencia_absoluta), y = frecuencia_absoluta)) +
geom_col(fill = "steelblue", color = "black") +
coord_flip() +
labs(
title = "Distribución de Títulos por Género Principal (2023)",
x     = "Género Cinematográfico",
y     = "Frecuencia Absoluta"
) +
theme_minimal()
print(grafico_generos)
# 2. Histograma: Duración (Cuantitativa Continua)
grafico_histograma <- ggplot(datos_tp, aes(x = runtimeMinutes)) +
geom_histogram(fill = "darkorange", color = "black", bins = 20) +
labs(
title = "Distribución Empírica de la Duración de los Títulos",
x     = "Duración (minutos)",
y     = "Frecuencia Absoluta"
) +
theme_minimal()
print(grafico_histograma)
# 3. Boxplot: Duración (Cuantitativa Continua)
grafico_boxplot <- ggplot(datos_tp, aes(y = runtimeMinutes)) +
geom_boxplot(fill = "lightgreen", color = "black") +
labs(
title = "Dispersión y Valores Atípicos de la Duración",
y     = "Duración (minutos)",
x     = ""
) +
theme_minimal()
print(grafico_boxplot)
# --- [A] ANÁLISIS: Estimación (Intervalos de Confianza) ---
# a) Variable cualitativa elegida: categoria_duracion
# Justificación: permite comparar la cantidad de géneros entre cortometrajes y
# largometrajes, dos subpoblaciones con lógicas de producción distintas.
# Se espera que el mercado cinematográfico de 2023 muestre diferencias
# estructurales entre ambos formatos.
# b) Parámetro de interés: media poblacional de cant_generos
#    µ_corto = media de cant_generos en la subpoblación de Cortometrajes
#    µ_largo = media de cant_generos en la subpoblación de Largometrajes
# Se comparan los extremos de la escala: Cortometraje y Largometraje
grupos_ic <- datos_tp %>%
filter(categoria_duracion %in% c("Cortometraje", "Largometraje"))
# c) IC al 95% para la media de cant_generos en cada grupo (t de Student)
ic_por_grupo <- grupos_ic %>%
group_by(categoria_duracion) %>%
summarise(
n         = n(),
media     = mean(cant_generos),
desvio_s  = sd(cant_generos),
error_est = desvio_s / sqrt(n),
t_critico = qt(0.975, df = n - 1),
lim_inf   = media - t_critico * error_est,
lim_sup   = media + t_critico * error_est,
.groups   = "drop"
)
print(ic_por_grupo)
# 4. Gráfico de ICs: estimación puntual con barras de error
grafico_ic <- ggplot(ic_por_grupo, aes(x = categoria_duracion, y = media, color = categoria_duracion)) +
geom_point(size = 4) +
geom_errorbar(aes(ymin = lim_inf, ymax = lim_sup), width = 0.2, linewidth = 1.2) +
labs(
title    = "IC 95% para la Cantidad Media de Géneros por Categoría de Duración",
subtitle = "Estimación puntual ± margen de error (t de Student)",
x        = "Categoría de Duración",
y        = "Cantidad Media de Géneros"
) +
theme_minimal() +
theme(legend.position = "none")
print(grafico_ic)
# 5. Boxplot comparativo: distribución de cant_generos por categoría
grafico_boxplot_grupos <- ggplot(datos_tp, aes(x = categoria_duracion, y = cant_generos, fill = categoria_duracion)) +
geom_boxplot(color = "black") +
labs(
title = "Distribución de Cantidad de Géneros por Categoría de Duración",
x     = "Categoría",
y     = "Cantidad de Géneros"
) +
theme_minimal() +
theme(legend.position = "none")
print(grafico_boxplot_grupos)
# --- [C] CONCLUSIÓN ---
# Esta etapa se documenta en el informe PDF, no en el código.
# Incluye: interpretación de los resultados del análisis descriptivo y de los
# intervalos de confianza, e indicación de si la conclusión es exhaustiva
# (cubre toda la población) o preliminar (sujeta a ampliación con más datos).
View(Water_Quality_Testing)

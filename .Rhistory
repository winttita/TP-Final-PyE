# Variable Cualitativa Ordinal: Discretización de la variable continua
categoria_duracion = case_when(
runtimeMinutes <= 30 ~ "Cortometraje",
runtimeMinutes > 30 & runtimeMinutes <= 60 ~ "Mediometraje",
